# Public Supabase project values. These are embedded into browser bundles at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public GA4 measurement ID (G-XXXXXXXX). Embedded into the browser bundle at build time.
# Leave empty to disable the Google tag. Never put a GA4 API secret here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set to 1 only when you want GA4 DebugView. Do not enable this on production builds.
NEXT_PUBLIC_GA_DEBUG=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
EVENT_HASH_SALT=

# HMAC key for participant session cookies. Generate at least 32 random bytes.
# Required in production and must never use the NEXT_PUBLIC_ prefix.
PARTICIPANT_SESSION_SECRET=

# Comma-separated, lower/upper case-insensitive Supabase Auth email allowlist.
# Required in production. DEV_ADMIN_EMAILS is only used outside production when ADMIN_EMAILS is unset.
ADMIN_EMAILS=
DEV_ADMIN_EMAILS=

# Explicit target for scripts that can mutate a remote environment. Do not point this at production casually.
SUPABASE_URL=
TEST_BASE_URL=
# Mutable E2E refuses to start unless this value is exactly "staging".
TEST_TARGET_ENV=
# Exact host allowlist for the staging E2E. Values contain hostnames only.
TEST_STAGING_APP_HOST=
TEST_STAGING_SUPABASE_HOST=

# Destructive cleanup requires an exact hostname match in addition to its CLI confirmation flag.
CLEANUP_SUPABASE_HOST=
